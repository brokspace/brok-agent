{
  "name": "brok-agent",
  "version": "0.5.2",
  "description": "Default Brokspace system shard: git change tracking, pre-indexation review and RAG answers",
  "authors": [
    "Brokspace contributors"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/brokspace/brok-agent",
  "brok": ">=0.8.0, <1.0.0",
  "entrypoint": "bin/brok-agent",
  "runtime": "native",
  "permissions": {
    "filesystem": {
      "read": [
        "."
      ],
      "write": []
    },
    "network": true,
    "process": [
      "git"
    ],
    "env": [
      "*_API_KEY",
      "OPENAI_*",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY"
    ]
  },
  "subscribes_to": [
    "agent:ask"
  ],
  "publishes_to": [
    "file:changed",
    "review:result",
    "agent:ask.*",
    "index:search"
  ],
  "build": {
    "command": [
      "cargo",
      "build",
      "--release"
    ],
    "artifact": "target/release/brok-agent"
  },
  "releases": {
    "linux-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.2/brok-agent-linux-aarch64",
      "sha256": "1755e4b210f7da92cc37f697f4b71616ceab1776dbd1947250100b3908993aae"
    },
    "linux-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.2/brok-agent-linux-x86_64",
      "sha256": "7250d6c31abb2386533796470a6519e6a2e19c9ef20e992b5ee68f57a0397c41"
    },
    "macos-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.2/brok-agent-macos-aarch64",
      "sha256": "39b7151d1bff9e0a22c741add310e9fad6dc01d093185881b605c286c940dd2a"
    },
    "macos-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.2/brok-agent-macos-x86_64",
      "sha256": "4a3dc902049bfccc5f78681637b77869e9c2a6b11e560ab0803e31c7feea5bb5"
    },
    "windows-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.2/brok-agent-windows-x86_64.exe",
      "sha256": "1025b1452792c3497815e97a48c06f510c647daaca5a21e08cd27fea43a7e27e"
    }
  }
}
