{
  "name": "brok-agent",
  "version": "0.5.0",
  "description": "Default Brokspace system shard: git change tracking, pre-indexation review and RAG answers",
  "authors": [
    "Brokspace contributors"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/brokspace/brok-agent",
  "entrypoint": "bin/brok-agent",
  "runtime": "native",
  "permissions": {
    "filesystem": {
      "read": [
        "."
      ],
      "write": []
    },
    "network": true,
    "process": [
      "git"
    ],
    "env": [
      "*_API_KEY",
      "OPENAI_*",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY"
    ]
  },
  "subscribes_to": [
    "agent:ask"
  ],
  "publishes_to": [
    "file:changed",
    "review:result",
    "agent:ask.*",
    "index:search"
  ],
  "build": {
    "command": [
      "cargo",
      "build",
      "--release"
    ],
    "artifact": "target/release/brok-agent"
  },
  "releases": {
    "linux-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.0/brok-agent-linux-aarch64",
      "sha256": "d701ec2812d62bc736505459adbe6b722a2a96199dd5da45467b201085fcf015"
    },
    "linux-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.0/brok-agent-linux-x86_64",
      "sha256": "3e226ddd3d3b2b996542b7092206ab16b29c37f0903c91fff9ecd949c9b0705e"
    },
    "macos-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.0/brok-agent-macos-aarch64",
      "sha256": "7c1225a9ccec40912c08034a9d59d4c04660f1f459d736acbd00a78b1e86d3fa"
    },
    "macos-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.0/brok-agent-macos-x86_64",
      "sha256": "8221b4cdce2df5d3ca7e359ab0f9d53f1c7468b91c9ba886920211d01d289d4b"
    },
    "windows-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.0/brok-agent-windows-x86_64.exe",
      "sha256": "ef2a4b3846a6fee42eab6fa7bca971b6d0834511455cebc9b42a6ab7d54f7af3"
    }
  }
}
