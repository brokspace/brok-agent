{
  "name": "brok-agent",
  "version": "0.2.1",
  "description": "Default Brokspace system shard: git change tracking, pre-indexation review and RAG answers",
  "authors": [
    "Brokspace contributors"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/brokspace/brok-agent",
  "entrypoint": "bin/brok-agent",
  "runtime": "native",
  "permissions": {
    "filesystem": {
      "read": [
        "."
      ],
      "write": []
    },
    "network": true,
    "process": [
      "git"
    ],
    "env": [
      "*_API_KEY",
      "OPENAI_*",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY"
    ]
  },
  "subscribes_to": [
    "agent:ask"
  ],
  "publishes_to": [
    "file:changed",
    "review:result",
    "agent:ask.*",
    "index:search"
  ],
  "build": {
    "command": [
      "cargo",
      "build",
      "--release"
    ],
    "artifact": "target/release/brok-agent"
  },
  "releases": {
    "linux-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.2.1/brok-agent-linux-aarch64",
      "sha256": "5c6d4c1257ee90a381cabd43287d694f3bc57ed0bf86d17515a14f54ac946551"
    },
    "linux-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.2.1/brok-agent-linux-x86_64",
      "sha256": "a5bc232b21060f0439d47f4d791fdf6c306ce14633c06f3070ada4d8327d0b74"
    },
    "macos-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.2.1/brok-agent-macos-aarch64",
      "sha256": "cb9ae6434b2db0fead4ff6236b7ef4e07cd164fc689f9fa3ee4f054f86a3d9b0"
    },
    "macos-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.2.1/brok-agent-macos-x86_64",
      "sha256": "74bac46e8dd9fcf33348035cd21d2c906d3054094202922f7624f74572e01e0e"
    },
    "windows-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.2.1/brok-agent-windows-x86_64.exe",
      "sha256": "a4e01003bbd7f50dea4dc3b5247f3e9a63935f0a6c59968d372629016c4af4a0"
    }
  }
}
