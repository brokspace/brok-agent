{
  "name": "brok-agent",
  "version": "0.5.1",
  "description": "Default Brokspace system shard: git change tracking, pre-indexation review and RAG answers",
  "authors": [
    "Brokspace contributors"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/brokspace/brok-agent",
  "entrypoint": "bin/brok-agent",
  "runtime": "native",
  "permissions": {
    "filesystem": {
      "read": [
        "."
      ],
      "write": []
    },
    "network": true,
    "process": [
      "git"
    ],
    "env": [
      "*_API_KEY",
      "OPENAI_*",
      "HTTP_PROXY",
      "HTTPS_PROXY",
      "NO_PROXY"
    ]
  },
  "subscribes_to": [
    "agent:ask"
  ],
  "publishes_to": [
    "file:changed",
    "review:result",
    "agent:ask.*",
    "index:search"
  ],
  "build": {
    "command": [
      "cargo",
      "build",
      "--release"
    ],
    "artifact": "target/release/brok-agent"
  },
  "releases": {
    "linux-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.1/brok-agent-linux-aarch64",
      "sha256": "ef5ea044ca0b30e8c5d9b33f5afb2ae616d059e77c656165993583ffa2c035e4"
    },
    "linux-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.1/brok-agent-linux-x86_64",
      "sha256": "cfeadde1d66425eca315e486c8a520dba3909cab765e42dfe80aac562c8f11fb"
    },
    "macos-aarch64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.1/brok-agent-macos-aarch64",
      "sha256": "1edf1b6e8854855df19033d73c100f3de668bcf1367e8ee670e3a715e8151b4a"
    },
    "macos-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.1/brok-agent-macos-x86_64",
      "sha256": "adfa7b6140ae2106b90e25195f3bdd7ac774dd284e504f0258d6093f1050fb7f"
    },
    "windows-x86_64": {
      "url": "https://github.com/brokspace/brok-agent/releases/download/v0.5.1/brok-agent-windows-x86_64.exe",
      "sha256": "9af05010045b59b0b65c4f0a7ce822de7c8bc73e890ddf1a585245c6492fcf2a"
    }
  }
}
